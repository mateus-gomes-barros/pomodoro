<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/small_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_focus_background">

    <TextView
        android:id="@+id/small_streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="32sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/small_streak_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0"
        android:textColor="#34D399"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/small_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="dias de ofensiva"
        android:textColor="#A1A1AA"
        android:textSize="11sp"
        android:gravity="center" />

</LinearLayout>
