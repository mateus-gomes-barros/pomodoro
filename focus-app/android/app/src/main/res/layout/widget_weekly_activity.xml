<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_focus_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Foco semanal"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🔥 0 dias de ofensiva"
        android:textColor="#34D399"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="7">

        <TextView android:id="@+id/day_1" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_2" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_3" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_4" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_5" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_6" style="@style/FocusWidgetDay" android:text="○" />
        <TextView android:id="@+id/day_7" style="@style/FocusWidgetDay" android:text="○" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="0m de foco"
        android:textColor="#A1A1AA"
        android:textSize="13sp" />

</LinearLayout>
