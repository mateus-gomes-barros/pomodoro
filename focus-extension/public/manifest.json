{
  "manifest_version": 3,
  "name": "Focus — Horizon",
  "version": "0.1.0",
  "description": "Quick access to your Focus timer, tasks and reminders.",
  "action": {
    "default_title": "Focus — Horizon",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://fjixvpdfbvfwgzzjlphb.supabase.co/*"
  ]
}
