{
  "manifest_version": 3,
  "name": "Focus — Horizon",
  "version": "0.1.1",
  "description": "Quick access to your Focus timer, tasks and reminders.",
  "action": {
    "default_title": "Focus — Horizon",
    "default_popup": "index.html",
    "default_icon": {
      "16": "focus-clock-approved-128.png",
      "32": "focus-clock-approved-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://fjixvpdfbvfwgzzjlphb.supabase.co/*"
  ],
  "icons": {
    "16": "focus-clock-approved-128.png",
    "32": "focus-clock-approved-128.png",
    "48": "focus-clock-approved-128.png",
    "128": "focus-clock-approved-128.png"
  }
}
